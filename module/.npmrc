@rb-cep:registry=https://artifactory.redbullmediahouse.com/artifactory/api/npm/partner-projects-npm-local/

@cosmos:registry=https://artifactory.redbullmediahouse.com/artifactory/api/npm/rbds-npm-local/

@cep:registry=https://artifactory.redbullmediahouse.com/artifactory/api/npm/cep-npm-local/

# Security: only install third-party versions that have been public for at least
# 7 days, so malicious releases have time to be detected and pulled.
# Requires npm >= 11.17.0; older versions do not support the exclusions below.
min-release-age=7

# Internally published Red Bull packages are already gated by Artifactory, so
# they are exempt from the window and can be consumed immediately after release.
min-release-age-exclude[]=@rb-cep/custom-script
min-release-age-exclude[]=@cosmos/*
min-release-age-exclude[]=@cep/*
min-release-age-exclude[]=@rb3ca/*
min-release-age-exclude[]=@rbup/*

